# Environment Mode
NODE_ENV=development

# Server Configuration
PORT=3001

# Allowed Origins for CORS (e.g., frontend URL on Vercel)
# For development use http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Authentication Secrets
# JWT Secret for signing session tokens
JWT_SECRET=super_secret_jwt_key
# 6-digit passcode for administrator login
ADMIN_PASSKEY=424242

# Database Connection String
# Render: use the PostgreSQL Internal Database URL, for example:
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional direct connection URL for Prisma migrations/push.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# External APIs
NASA_API_KEY="DEMO_KEY"
GEMINI_API_KEY=your_gemini_api_key_here
